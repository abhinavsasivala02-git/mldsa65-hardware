// =============================================================================
// mldsa65_ref_kat0.vh - hardcoded reference KAT (vector 0) for ML-DSA-65 keygen
//
// Self-contained KeyGen known-answer for the seed KAT0_SEED (see
// mldsa65_kat_vectors.vh).  Packed little-endian: byte k of the key is bits
// [8*k +: 8] of the reg.
// =============================================================================

reg [15615:0] KAT0_PK = 15616';

reg [32255:0] KAT0_SK = 32256';
